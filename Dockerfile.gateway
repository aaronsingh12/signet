# A dedicated image CMD keeps gateway startup independent of service command overrides.
FROM node:24-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
COPY policy ./policy
RUN npm ci --ignore-scripts && npm run build

FROM node:24-slim
ENV NODE_ENV=production VERCEL=1 SIGNET_HOME=/app SIGNET_DATA_DIR=/tmp/signet NODE_USE_SYSTEM_CA=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm init -y >/dev/null && npm install --omit=dev --ignore-scripts express@4.21.2 @open-policy-agent/opa-wasm@1.10.0 && npm cache clean --force
COPY --from=build /src/dist/gateway.mjs /src/dist/detector-worker.mjs ./
COPY --from=build /src/dist/policy ./policy
USER node
EXPOSE 3000
CMD ["node", "gateway.mjs"]
