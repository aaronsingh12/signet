# Copy to .env. Runtime keys are generated into data/dev-secrets.json for local development.
# Signet shows only what really happened: no setting turns on demo or sample data.

# --- Database (required) ---------------------------------------------------------------------------
# Neon (or any) PostgreSQL. Remote databases always use verified TLS.
DATABASE_URL=postgresql://user:password@host/dbname
# Local development: a PostgreSQL on this machine may run without TLS, only when asked explicitly:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/signet?sslmode=disable

# --- Sign-in --------------------------------------------------------------------------------------
# One local administrator. In local mode that administrator does every step, including approvals;
# the ledger records that separation of duties was waived. Set SIGNET_SINGLE_OPERATOR=false (and use
# an OIDC provider with real users) to enforce separation of duties again.
SIGNET_AUTH_MODE=local
SIGNET_ADMIN_ID=admin
SIGNET_ADMIN_PASSWORD=
SIGNET_TENANT_NAME=Signet
# SIGNET_SINGLE_OPERATOR=true
# SIGNET_OIDC_ISSUER=https://id.example.com/realms/signet
# SIGNET_OIDC_CLIENT_ID=signet-console
# SIGNET_OIDC_CLIENT_SECRET=

# --- Ports and public addresses ----------------------------------------------------------------------
SIGNET_CONTROL_PORT=4100
SIGNET_GATEWAY_PORT=8100
SIGNET_CONTROL_URL=http://localhost:4100
# The addresses agents use. Required to connect workloads on Vercel, AWS or Azure to Signet:
# SIGNET_GATEWAY_PUBLIC_URL=https://signet-deploy.vercel.app
# SIGNET_CONTROL_PUBLIC_URL=https://signet-deploy.vercel.app

# --- The one cloud LLM (Rulebook v0.2, D-17) --------------------------------------------------------
SIGNET_LLM_BASE_URL=http://localhost:11434/v1
SIGNET_LLM_MODEL=gpt-oss:120b-cloud
SIGNET_LLM_UPSTREAM_MODEL=gpt-oss:120b
# Dev fallback only; the Secrets Broker (kind "LLM provider key") takes precedence.
# SIGNET_LLM_API_KEY=

# Quality checks: share of answered model calls scored by the same model as a judge (0..1). Each scored
# call costs a second model call. Off when unset.
# SIGNET_EVAL_SAMPLE_RATE=0.05

# --- Tools ----------------------------------------------------------------------------------------
# Cloud metadata and link-local addresses are never reachable. Loopback and private networks only if:
# SIGNET_TOOL_PRIVATE_DESTINATIONS=allow

# --- Optional "Sign in with Vercel" (identity only; project connectors use an access token) -----------
# SIGNET_VERCEL_CLIENT_ID=
# SIGNET_VERCEL_CLIENT_SECRET=

SIGNET_ENV=dev

# Optional exact hostname allowlist for public REST connector egress. Private agents use the runner.
# SIGNET_CONNECTOR_HOST_ALLOWLIST=api.your-provider.example,identity.your-provider.example

# --- Evidence anchors (BP 8.3), all optional -------------------------------------------------------
# Write-once copies of each signed daily root and its records in S3 with Object Lock (COMPLIANCE mode).
# The bucket must be created with Object Lock enabled. AWS S3 and S3-compatible stores with Object Lock.
# SIGNET_EVIDENCE_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# SIGNET_EVIDENCE_S3_BUCKET=signet-evidence
# SIGNET_EVIDENCE_S3_REGION=eu-central-1
# SIGNET_EVIDENCE_S3_ACCESS_KEY_ID=
# SIGNET_EVIDENCE_S3_SECRET_ACCESS_KEY=
# SIGNET_EVIDENCE_RETENTION_DAYS=2555
# SIGNET_EVIDENCE_LOCK_MODE=COMPLIANCE
# RFC 3161 Time-Stamp Authority for each daily root, e.g. https://freetsa.org/tsr or http://timestamp.digicert.com
# SIGNET_TSA_URL=

# --- Key service for the Secrets Broker (BP 18.2) -------------------------------------------------
# Each brokered credential has its own data key, wrapped by this service. Revoking the key makes the
# credentials unreadable to Signet (agents stop). After switching, use "Move all secrets" (POST /secrets/rewrap).
# SIGNET_KMS_PROVIDER=local            # local | vault | aws-kms
# HashiCorp Vault or OpenBao transit engine:
# SIGNET_VAULT_ADDR=https://vault.example.com
# SIGNET_VAULT_TOKEN=
# SIGNET_VAULT_TRANSIT_MOUNT=transit
# SIGNET_VAULT_TRANSIT_KEY=signet
# SIGNET_VAULT_NAMESPACE=
# AWS KMS (symmetric key):
# SIGNET_AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:111122223333:key/...
# SIGNET_AWS_KMS_REGION=eu-central-1
# SIGNET_AWS_KMS_ACCESS_KEY_ID=
# SIGNET_AWS_KMS_SECRET_ACCESS_KEY=

# --- OpenTelemetry (gateway): one span per decision, GenAI conventions, metadata only -------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
# OTEL_SERVICE_NAME=signet-gateway

# --- SAML 2.0 sign-in (SIGNET_AUTH_MODE=saml) -----------------------------------------------------
# Give the identity provider: ACS URL <SIGNET_PUBLIC_URL>/api/v1/auth/saml/acs, entity ID
# <SIGNET_PUBLIC_URL>/api/v1/auth/saml/metadata, signed assertions, an email and a groups attribute.
# SIGNET_SAML_IDP_SSO_URL=https://login.microsoftonline.com/<tenant>/saml2
# SIGNET_SAML_IDP_CERT=MIIC...            # signing certificate; several separated by ";" during rotation
# SIGNET_SAML_IDP_ENTITY_ID=https://sts.windows.net/<tenant>/
# SIGNET_SAML_SP_ENTITY_ID=
# SIGNET_SAML_ATTR_EMAIL= / SIGNET_SAML_ATTR_NAME= / SIGNET_SAML_ATTR_GROUPS=
