# Copy to .env and configure the administrator credentials before local sign-in.
# Runtime keys are generated into data/dev-secrets.json for local development.

# Ports
SIGNET_CONTROL_PORT=4100
SIGNET_GATEWAY_PORT=8100
SIGNET_CONTROL_URL=http://localhost:4100

# Addresses agents use, shown in the console's connection instructions. Set these when agents run on
# other machines (RunPod, EC2, Kubernetes): they must reach the gateway and the control plane.
# SIGNET_GATEWAY_PUBLIC_URL=https://signet-gw.example.com
# SIGNET_CONTROL_PUBLIC_URL=https://signet.example.com

# The one cloud LLM (Rulebook v0.2, D-17). Default: gpt-oss:120b-cloud through the local Ollama daemon,
# which signs in to ollama.com itself, so no key is needed. To call a provider endpoint directly, set its
# OpenAI-compatible base URL and store the key in the Secrets Broker (console: Tools & secrets, kind
# "LLM provider key"). The gateways check the provider every minute; the console shows the result.
# Local administrator credentials are read from .env. Set auth mode to "oidc"
# to use an external OpenID Connect provider instead.
SIGNET_AUTH_MODE=local
SIGNET_ADMIN_ID=admin
SIGNET_ADMIN_PASSWORD=
SIGNET_TENANT_NAME=Signet
# SIGNET_OIDC_ISSUER=https://id.example.com/realms/signet
# SIGNET_OIDC_CLIENT_ID=signet-console
# SIGNET_OIDC_CLIENT_SECRET=

# Create a Vercel App and register http://localhost:5174/api/v1/plugins/vercel/callback
# as its authorization callback URL before enabling the Vercel plugin.
# SIGNET_VERCEL_CLIENT_ID=
# SIGNET_VERCEL_CLIENT_SECRET=

# The one cloud LLM (Rulebook v0.2, D-17). Default: gpt-oss:120b-cloud through the local Ollama daemon.
# To call the provider directly, set the provider's OpenAI-compatible base URL and a brokered API key.
SIGNET_LLM_BASE_URL=http://localhost:11434/v1
SIGNET_LLM_MODEL=gpt-oss:120b-cloud
SIGNET_LLM_UPSTREAM_MODEL=gpt-oss:120b
# Dev fallback only, reported as "key from env"; the Secrets Broker takes precedence.
# SIGNET_LLM_API_KEY=

# Tool destinations (SSRF protection). Cloud metadata and link-local addresses are never reachable.
# Loopback and private networks (a tool on this host, your VPC or VPN) are refused unless allowed here.
# SIGNET_TOOL_PRIVATE_DESTINATIONS=allow

# Environment this gateway serves (checked against the seal's environments[])
SIGNET_ENV=dev

# Optional fixed secrets (otherwise generated)
# SIGNET_INTERNAL_TOKEN=
# SIGNET_VAULT_KEY=
# SIGNET_BROKER_KEY=
