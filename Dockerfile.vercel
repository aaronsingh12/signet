# Vercel Services selects the process explicitly; the private edge runner is never the web entrypoint.
FROM openpolicyagent/opa:1.4.2-static AS opa

FROM node:24-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
COPY policy ./policy
# The gateway evaluates the reviewed Rego policy itself (OPA WebAssembly), not only its TypeScript copy.
# The build stops if the Rego conformance tests fail.
COPY --from=opa /opa /usr/local/bin/opa
RUN opa test policy/ && opa build -t wasm -e signet/decision/result policy/signet.rego -o /tmp/policy-bundle.tar.gz \
  && mkdir -p policy/dist && tar -xzf /tmp/policy-bundle.tar.gz -C policy/dist /policy.wasm && chmod 644 policy/dist/policy.wasm && rm /tmp/policy-bundle.tar.gz
RUN npm ci --ignore-scripts && npm run build

FROM node:24-slim
ENV NODE_ENV=production VERCEL=1 SIGNET_HOME=/app SIGNET_DATA_DIR=/tmp/signet NODE_USE_SYSTEM_CA=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm init -y >/dev/null && npm install --omit=dev --ignore-scripts express@4.22.3 pg@8.23.1 @open-policy-agent/opa-wasm@1.10.0 && npm cache clean --force
COPY --from=build /src/dist/control.mjs /src/dist/gateway.mjs /src/dist/maintenance.mjs /src/dist/detector-worker.mjs ./
COPY --from=build /src/dist/policy ./policy
USER node
EXPOSE 3000
CMD ["node", "control.mjs"]
