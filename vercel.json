{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "control": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "gateway": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.gateway",
      "bindings": [{ "type": "service", "service": "control", "format": "url", "env": "SIGNET_CONTROL_URL" }]
    }
  },
  "daemons": {
    "maintenance": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "command": ["node", "maintenance.mjs"],
      "instances": { "sin1": 1 },
      "resources": { "requests": { "memory": "1Gi" } },
      "bindings": [{ "type": "service", "service": "control", "format": "url", "env": "SIGNET_CONTROL_URL" }]
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": { "service": "gateway" } },
    { "source": "/api/tags", "destination": { "service": "gateway" } },
    { "source": "/api/:path*", "destination": { "service": "control" } },
    { "source": "/healthz", "destination": { "service": "control" } },
    { "source": "/v1/:path*", "destination": { "service": "gateway" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
